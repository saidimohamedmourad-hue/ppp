# ═══════════════════════════════════════════════════════════════════════════
# IQRA backend — example env
# Copy to `.env` and fill the blanks. Anything marked **prod-only** must be
# changed away from its default before going live.
# ═══════════════════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────────────────
APP_NAME=IQRA
APP_ENV=local                          # **prod-only** → production
APP_KEY=                               # `php artisan key:generate` after copy
APP_DEBUG=true                         # **prod-only** → false (leaks stack traces otherwise)
APP_URL=http://localhost:8000          # **prod-only** → https://api.iqra.app
APP_FRONTEND_URL=http://localhost:3000 # **prod-only** → https://iqra.app

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12                       # 12 in prod, 4 in tests (handled by phpunit.xml)

# ─── Logging ──────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single                       # **prod-only** → daily (file rotation)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                        # **prod-only** → warning

# ─── Database (MariaDB / MySQL 8) ─────────────────────────────────────────
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iqra
DB_USERNAME=iqra_user
DB_PASSWORD=                           # **never** commit a real password

# ─── Session / cache / queue ──────────────────────────────────────────────
SESSION_DRIVER=database                # **prod-only** → redis (faster + multi-instance safe)
SESSION_LIFETIME=120
SESSION_ENCRYPT=false                  # **prod-only** → true
SESSION_PATH=/
SESSION_DOMAIN=null                    # **prod-only** → .iqra.app

CACHE_STORE=database                   # **prod-only** → redis
QUEUE_CONNECTION=database              # **prod-only** → redis + supervisor worker

# ─── Redis (used in prod) ─────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (Phase 1) ───────────────────────────────────────────────────────
# Dev: use `log` so emails appear in storage/logs/laravel.log instead of
# actually being sent (saves quota, no waiting for SMTP).
# Prod: use a transactional provider (SendGrid / Mailgun / Postmark) — Gmail
# SMTP works but caps at 500/day and has fragile deliverability.
MAIL_MAILER=log                        # **prod-only** → smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587                          # 465 SSL is the fallback if 587 is blocked
MAIL_USERNAME=                         # your Gmail address
MAIL_PASSWORD=                         # 16-char App Password (NEVER your account pw)
MAIL_ENCRYPTION=tls                    # `ssl` when using port 465
MAIL_FROM_ADDRESS=noreply@iqra.app
MAIL_FROM_NAME=IQRA

# ─── Phase 2 — Google Sign-In ─────────────────────────────────────────────
# Web Client ID from Google Cloud Console → Credentials → OAuth Client (Web).
# Don't put the Client Secret here — we verify ID tokens with Google's public
# keys, no secret needed.
GOOGLE_WEB_CLIENT_ID=

# (optional) Native client IDs for the Flutter app — only set if you want a
# stricter audience check on the backend.
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=

# ─── Phase 3 — Facebook / Instagram (Meta) ────────────────────────────────
# App ID + App Secret from https://developers.facebook.com/apps/ → App Settings.
# Required server-side to call /debug_token for token validation.
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# ─── Phase 6 — Cloudflare Turnstile (CAPTCHA on /forgot-password) ─────────
# Test keys (always-pass) below — replace with real keys for prod and add the
# prod domain in Cloudflare → Turnstile → Hostname Management.
# Disabling Turnstile in tests: phpunit.xml sets both to empty strings.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ─── OpenAI (AI scoring of CVs) ───────────────────────────────────────────
# https://platform.openai.com/api-keys — billing must be set up.
# Cost is roughly $0.0001 per CV analysed with gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Storage / S3 (for resume PDFs in prod) ───────────────────────────────
FILESYSTEM_DISK=local                  # **prod-only** → s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-3
# AWS_BUCKET=iqra-resumes-prod
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Disabled in tests / dev ──────────────────────────────────────────────
BROADCAST_CONNECTION=log
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
